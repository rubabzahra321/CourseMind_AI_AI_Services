# ============================================================================
# CourseMind AI Services (FastAPI)  --  copy this file to ".env" and fill it in
# NEVER commit .env (it is already in .gitignore).
# ============================================================================

# ---- Supabase (Dashboard -> Project Settings -> API) -----------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# SECRET server key: "service_role" (legacy tab) or the "secret" key (sb_secret_...).
# It BYPASSES Row Level Security. Never put it in the frontend or in Git.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Shared secret between Node backend and this service -------------------
# Must be IDENTICAL to AI_INTERNAL_KEY in the Node Backend/.env.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_INTERNAL_KEY=

# ---- Google Gemini (https://aistudio.google.com/apikey) --------------------
GEMINI_API_KEY=
# The embedding size MUST equal the SQL column vector(768).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Chat/MCQ model. gemini-2.5-flash is DEPRECATED by Google (shutdown announced for late 2026).
# Run `python scripts/check_env.py` to list the models your key can use, then set one here.
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ---- Optional tuning (defaults shown) --------------------------------------
STORAGE_BUCKET=course-documents
WORKER_POLL_SECONDS=3
WORKER_STALE_MINUTES=10
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
MIN_PAGE_CHARS=20
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.35
MCQ_MAX_QUESTIONS=20
MCQ_CONTEXT_MAX_CHARS=18000
